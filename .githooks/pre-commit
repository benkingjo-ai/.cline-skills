#!/bin/sh
# Skills check - blocks the commit when the library is not clean.
# Installed as .githooks/pre-commit; activated by core.hooksPath (install-hook.ps1).
# This file must stay LF: see .gitattributes.
SCRIPT="skills/skill-authoring/scripts/check-skills.ps1"
if [ ! -f "$SCRIPT" ]; then
  echo "pre-commit: check script not found: $SCRIPT" >&2
  exit 1
fi
powershell -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT"
RC=$?
if [ $RC -ne 0 ]; then
  echo "pre-commit: skills check failed (exit $RC) - commit blocked" >&2
  exit 1
fi
exit 0
